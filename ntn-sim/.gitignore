# =============================================================================
# NTN-Sim .gitignore
# =============================================================================

# Build directories (auto-generated by CMake)
build/
Build/
BUILD/
out/
cmake-build-debug/
cmake-build-release/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Compiled binary outputs
*.exe
*.out
*.app
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj

# GoogleTest downloaded cache
googletest-*

# Log files generated by simulator
*.log
ntn-sim.log
test-ntn-sim.log

# Simulation output data
simulation_output.json
simulation_results.json

# IDE & Editor folders
.vscode/
.idea/
*.suo
*.sln.user
*.user
*.ncb
*.sdf

# Windows OS files
Thumbs.db
Desktop.ini
ehthumbs.db

# macOS OS files
.DS_Store
.AppleDouble
.LSOverride

# Python bytecode (for scripts/)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Temporary files
*.tmp
*.temp
*.swp
*.bak
*~
