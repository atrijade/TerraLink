# =============================================================================
# NTN-Sim Root .gitignore
# =============================================================================

# Build directory (auto-generated by CMake - NEVER commit this)
build/
Build/
BUILD/
out/
cmake-build-debug/
cmake-build-release/
cmake-build-*/

# Log files generated at runtime
*.log
ntn-sim.log
test-ntn-sim.log

# CMake generated files (if build is inside project)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
_deps/
compile_commands.json

# Compiled binaries and object files
*.exe
*.out
*.a
*.lib
*.dll
*.so
*.o
*.obj

# IDE folders
.vscode/
.idea/
*.suo
*.user

# Windows OS files
Thumbs.db
Desktop.ini

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Temporary files
*.tmp
*.temp
*.bak
*~
